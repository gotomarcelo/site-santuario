GOOGLE_DOCUMENT_ID=

# ID da pasta raiz no Drive (site multipágina). Preferível a GOOGLE_DOCUMENT_ID.
GOOGLE_DRIVE_FOLDER_ID=

# JSON completo da chave da conta de serviço (alternativa a credentials.json).
