---
import type { NewsImageBlock } from "../../../lib/types";
import { siteUrl } from "../../../lib/urls";
import "./NewsImage.scss";

const { image, title, imageAlt } = Astro.props as NewsImageBlock;
---

<figure class="news-image">
  <img src={siteUrl(image)} alt={imageAlt} />
  {title && <figcaption>{title}</figcaption>}
</figure>
