---
import type { HeroBlock } from "../../../lib/types";
import { siteUrl } from "../../../lib/urls";
import "./Hero.scss";

const {
  eyebrow,
  title,
  highlight,
  titleAfter,
  description,
  image,
  imageAlt,
  caption,
} = Astro.props as HeroBlock;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__content">
    <svg
      class="hero__arch"
      viewBox="0 0 120 140"
      fill="none"
      aria-hidden="true"
    >
      <path d="M10 140V60Q10 10 60 10t50 50v80"></path>
      <path d="M25 140V65Q25 25 60 25t35 40v75"></path>
    </svg>
    <div class="hero__rule" aria-hidden="true"></div>
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span aria-hidden="true"></span>{eyebrow}<span aria-hidden="true"
        ></span>
      </p>
      <h1 id="hero-title">
        {title}
        <em>{highlight}</em>{titleAfter ? `, ${titleAfter}` : ""}
      </h1>
      <div class="hero__accent" aria-hidden="true"></div>
      <p class="hero__description">{description}</p>
    </div>
  </div>
  <div class="hero__media">
    <img src={siteUrl(image)} alt={imageAlt} />
    {
      caption && (
        <p class="hero__caption">
          <span aria-hidden="true" />
          {caption}
        </p>
      )
    }
  </div>
</section>
