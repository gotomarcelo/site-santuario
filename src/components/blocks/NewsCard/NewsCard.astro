---
import type { NewsSummary } from "../../../lib/news";
import { formatNewsDate } from "../../../lib/news";
import "./NewsCard.scss";

const { news } = Astro.props as { news: NewsSummary };
---

<article class="news-card">
  <a class="news-card__image-link" href={`/noticias/${news.slug}/`}>
    <img src={news.image} alt={news.imageAlt} loading="lazy" />
  </a>
  <div class="news-card__body">
    <div class="news-card__meta">
      {
        news.category && (
          <span class="news-card__category">{news.category}</span>
        )
      }
      <time datetime={news.createdAt}>{formatNewsDate(news.createdAt)}</time>
    </div>
    {news.title && <h3><a href={`/noticias/${news.slug}/`}>{news.title}</a></h3>}
    {news.excerpt && <p>{news.excerpt}</p>}
    <a class="news-card__read-more" href={`/noticias/${news.slug}/`}
      >Ler mais <span aria-hidden="true">→</span></a
    >
  </div>
</article>
