---
import type { NewsBannerBlock } from "../../../lib/types";
import { siteUrl } from "../../../lib/urls";
import "./NewsBanner.scss";

const { image, imageAlt, category } = Astro.props as NewsBannerBlock;
---

<div class="news-banner">
  <img src={siteUrl(image)} alt={imageAlt} />
  {category && <span>{category}</span>}
</div>
