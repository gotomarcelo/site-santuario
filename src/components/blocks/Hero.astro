---
import type { HeroBlock } from '../../lib/types';

const { title, description, image, cta } = Astro.props as HeroBlock;
---

<section class="hero">
  <div class="hero__content">
    <p class="eyebrow">Google Docs → HTML estático</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <a class="button" href={cta.href}>{cta.label}</a>
  </div>
  <img class="hero__image" src={image} alt="" />
</section>
